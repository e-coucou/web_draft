<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>QR-Code Metrics ...</title>
    <link href="/css/styleTail.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
    @media (max-width: 600px) {
    .footer-bar {
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        }
    }
    @media (min-width: 768px) {
    .table-wrapper {
        max-height: none;
        overflow-y: visible;
        }
    }
    </style>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        const token = localStorage.getItem('accessToken');
        const nickname = localStorage.getItem('nickname');
        const loginButton = document.getElementById('loginBtn');
        const toggleButton = document.getElementById('theme-toggle');
        // Gestion du theme jour/nuit
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
          toggleButton.textContent = '☀️';
        } else {
          document.documentElement.classList.remove('dark');
          toggleButton.textContent = '🌙';
        }
        toggleButton.addEventListener('click', () => {
          document.documentElement.classList.toggle('dark');
          if (document.documentElement.classList.contains('dark')) {
            localStorage.setItem('theme', 'dark');
            toggleButton.textContent = '☀️';
          } else {
            localStorage.setItem('theme', 'light');
            toggleButton.textContent = '🌙';
          }
        });
        if (token && nickname) {
        loginButton.value = "logout";
        loginButton.innerHTML = '👤 '+localStorage.nickname + ' 🔚';
    } else {
        loginButton.innerHTML = "logIn";
    };

      });
    </script>
  <body class="bg-backgroundLight dark:bg-backgroundDark dark:text-textLight text-textDark font-sans transition-colors duration-300">
    <header class="bg-backgroundLight dark:bg-backgroundDark shadow p-4 flex items-center justify-between" style="z-index: 100;width: 100%;">
      <div class="flex items-center gap-4">
        <a href="/">
          <img src="../../img/ecoucou.png" alt="eCoucou" class="h-12"/>
        </a>
        <!-- <h1 class="text-xl font-semibold">QR-Code</h1> -->
        <nav class=" shadow-md fixed w-full z-10">
          <div class="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center">
            <div class="text-xl font-bold text-blue-600"></div>
            <div class="space-x-4 dark:text-textLight text-textDark">
              <!-- <a href="terms.html" class="hover:text-blue-200">Terms</a>
              <a href="/api/qrcode/doc" class="hover:text-blue-500">Documentation</a> -->
              <a>
                <button id="loginBtn" class="bg-accent dark:bg-primary px-4 py-2 rounded-full shadow-lg z-50">login</button>
                <button id="theme-toggle" class="bg-accent dark:bg-primary text-white px-4 py-2 rounded-full shadow-lg z-50">🌙</button>
              </a>
            </div>
          </div>
        </nav>
      </div>
  </header>
<style>
    body {
        font-size: 1.9vw;
    }
    a {
      pointer-events: auto !important;
      z-index: 1000;
      position: relative;
    }
</style>
    <link rel="stylesheet" href="/css/style_api_vcard.css">

</head>
<div class="footer-bar">
  <button class="export-btn bg-primary dark:bg-primaryDark text-textDark dark:text-textLight px-4 py-1 rounded" onclick="window.location.href='/api/qrcode/export'">Exporter vers Excel (CSV)</button>
  <p id="recordCount" class="record-count bg-accent dark:bg-accent text-textDark px-4 py-1 rounded">0 enregistrements</p>
</div>
<div class="table-wrapper bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 font-sans transition-colors duration-300">
  <table id="data-table" >
    <thead>
      <tr class="bg-gray-100 dark:bg-gray-700 text-textDark font-sans transition-colors duration-300">
        <!-- <th><input type="text" onkeyup="filterTable(0)" placeholder="Filtrer ID" /></th> -->
        <th><input type="text" onkeyup="filterTable(0)" placeholder="Filtrer Level" /></th>
        <th><input type="text" onkeyup="filterTable(1)" placeholder="Filtrer Option" /></th>
        <th><input type="text" onkeyup="filterTable(2)" placeholder="Filtrer Qualité" /></th>
        <th><input type="text" onkeyup="filterTable(3)" placeholder="Filtrer Temps" /></th>
        <th><input type="text" onkeyup="filterTable(4)" placeholder="Filtrer Type" /></th>
        <th><input type="text" onkeyup="filterTable(5)" placeholder="Filtrer Version" /></th>
      </tr>
      <tr class="sticky top-0 z-10 bg-gray-300 dark:bg-gray-900 text-gray-800 dark:text-gray-200 font-sans transition-colors duration-300"">
        <!-- <th>ID <span id="arrow-0"></span></th> -->
        <th>Level <span id="arrow-1"></span></th>
        <th>Option <span id="arrow-2"></span></th>
        <th>Qualité <span id="arrow-3"></span></th>
        <th>Time <span id="arrow-4"></span></th>
        <th>Type <span id="arrow-5"></span></th>
        <th>Version <span id="arrow-6"></span></th>
      </tr>
    </thead>
    <tbody>
      <% data.forEach(item => { %>
        <tr class="odd:bg-white even:bg-gray-200 dark:odd:bg-gray-600 dark:even:bg-gray-800
          <%= (item.vcard && item.vcard.trim() !== '') ? ' clickable dark:text-[#33BAA5] text-[#63DAC5] hover:bg-[#33AA95] dark:hover:bg-[#73EAD5] transition-colors cursor-pointer' : '' %>"
            <% if (item.vcard && item.vcard.trim() !== '') { %>
                onclick="handleRowClick('<%= item.id %>','<%= item.vcard %>')"
                style="cursor: pointer;"
            <% } %>
        >
          <!-- <td><%= item.id %></td> -->
          <td><%= item.level %></td>
          <td><%= item.option %></td>
          <td><%= item.qualite %></td>
          <td><%= item.timeFormatted %></td>
            <!-- <td><script>document.write(formatTimestamp(<%= item.time %>));</script></td> -->
          <!-- <td style="color: <%= item.hasVCard ? '#2266FF' : 'inherit' %>;"> -->
            <td>
            <%= item.type %>
          </td>
          <!-- <td><%= item.hasVCard %></td> -->
          <td><%= item.version %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
  </script>

  <div id="loading">Chargement...</div>

  <script>
    let start = <%= data.length %>;
    const limit = 10;
    const loading = document.getElementById('loading');

    $(window).scroll(function() {
      if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
        loadMoreData();
      }
    });

    function loadMoreData() {
      $('#loading').show();

      $.get(`/api/qrcode/data?start=${start}`, function(newData) {
        if (newData.length > 0) {
          newData.forEach(item => {
            $('#data-table tbody').append(`
              <tr>
                <td>${item.level}</td>
                <td>${item.option}</td>
                <td>${item.qualite}</td>
                <td>${item.time}</td>
                <td>${item.type}</td>
                <td>${item.version}</td>
              </tr>
            `);
          });
          start += limit;
        }
        loading.textContent = "... done ...";
        // $('#loading').hide();
      });
    }
    function filterTable(columnIndex) {
        let input = document.querySelectorAll("thead input")[columnIndex];
        let filter = input.value.toUpperCase();
        let table = document.getElementById("data-table");
        let rows = table.getElementsByTagName("tr");
        for (let i = 2; i < rows.length; i++) { // skip header rows
        let cells = rows[i].getElementsByTagName("td");
        if (cells[columnIndex]) {
            let text = cells[columnIndex].textContent || cells[columnIndex].innerText;
            rows[i].style.display = text.toUpperCase().indexOf(filter) > -1 ? "" : "none";
        }
        }
    }    
  document.addEventListener("DOMContentLoaded", () => {
    const headers = document.querySelectorAll("#data-table thead tr:last-child th");
    headers.forEach((header, index) => {
      header.style.cursor = "pointer";
      header.addEventListener("click", () => sortTable(index));
    });
    const count = document.querySelectorAll("table tbody tr").length;
    document.getElementById("recordCount").textContent = `${count} enregistrements`;
  });

  let currentSortedColumn = null;
  let sortDirection = null; // true = asc, false = desc

  function sortTable(colIndex) {
    const table = document.getElementById("data-table");
    const rows = Array.from(table.rows).slice(2); // skip filter + header
    // Inverser si on clique la même colonne
    if (currentSortedColumn === colIndex) {
      sortDirection = !sortDirection;
    } else {
      sortDirection = true;
      currentSortedColumn = colIndex;
    }

    // Nettoyer les flèches
    for (let i = 0; i < table.rows[0].cells.length; i++) {
      const arrow = document.getElementById(`arrow-${i}`);
      if (arrow) arrow.innerText = '';
    }

    // Mettre la flèche active
    const arrow = document.getElementById(`arrow-${colIndex+1}`); //index+1 car col ID non affiche
    if (arrow) arrow.innerText = sortDirection ? '▲' : '▼';

    // Trier les lignes
    rows.sort((a, b) => {
      const cellA = a.cells[colIndex];
      const cellB = b.cells[colIndex];

      const rawA = cellA.dataset.value || cellA.innerText.trim();
      const rawB = cellB.dataset.value || cellB.innerText.trim();

      // Forcer conversion numérique si possible
      const valA = isNaN(rawA) ? rawA : Number(rawA);
      const valB = isNaN(rawB) ? rawB : Number(rawB);

      if (typeof valA === "number" && typeof valB === "number") {
        return sortDirection ? valA - valB : valB - valA;
      } else {
        return sortDirection
          ? valA.toString().localeCompare(valB)
          : valB.toString().localeCompare(valA);
      }
    });
    
    // Réinsérer les lignes
    rows.forEach(row => table.tBodies[0].appendChild(row));
  }

  async function handleRowClick(id, vcard) {
    // alert("Ligne cliquée avec ID : " + id + '\n' + vcard);
    // ou window.location.href = `/details/${id}`;
      try {
          const response = await fetch('/api/qrcode/decypherjson', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ vcard: vcard })
          });

        const html = await response.text();

        // Extraire uniquement le texte clair du HTML retourné
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const plaintext = doc.querySelector('p')?.textContent;

        if (plaintext) {
          alert('Texte déchiffré :\n' + plaintext);
        } else {
          alert('Erreur : impossible de lire la réponse');
        }
      } catch (error) {
        alert('Erreur : ' + error);
      }
    }

    function formatTimestamp(ts) {
      const date = new Date(Number(ts));
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth()+1).padStart(2, '0');
     const year = String(date.getFullYear()).slice(2);
      const hours = String(date.getHours()).padStart(2, '0');
      const minutes = String(date.getMinutes()).padStart(2, '0');
      return `${day}/${month}/${year} ${hours}:${minutes}`;
    }
    // Get version
    async function getVersion() {
        const res = await fetch('/api/qrcode/version');
        const vData = await res.json();
        document.getElementById('version').textContent = `© 2025 e-Coucou — v${vData.version} - ${vData.maj}`;
    }
    getVersion();
  </script>
  <footer class="text-center text-[10px] fixed bottom-4 left-1/2 -translate-x-1/2 bg-primary dark:bg-primaryDark dark:text-AccentClair text-AccentClair py-0.5 rounded-full shadow">
    <p id="version"></p>
  </footer>
</body>
</html>